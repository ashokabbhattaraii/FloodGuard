# Non-secret platform configuration ONLY.
#
# Credentials used to live here (DATABASE_URL with the RDS master password, and
# JWT_SECRET) which committed them to git history. They are now generated into
# AWS Secrets Manager by infra/steps/20-secrets.sh and injected as environment
# properties at deploy time by infra/steps/30-eb-backend.sh.
#
# Do not add secrets to this file.
option_settings:
  aws:elasticbeanstalk:command:
    Timeout: "1800"
  aws:autoscaling:launchconfiguration:
    InstanceType: "t3.small"
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: "production"
    PORT: "8080"
    AWS_REGION: "us-east-1"
    # The in-process @nestjs/schedule cron is superseded by
    # EventBridge Scheduler -> fg-weather-ingest. Enabling both double-fires alerts.
    FLOOD_MONITOR_ENABLED: "false"
