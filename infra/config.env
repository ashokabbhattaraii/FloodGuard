# FloodGuard — deployment configuration
# Single source of truth for every resource name. Safe to commit (no secrets).

PROJECT=floodguard
AWS_REGION=us-east-1
EXPECTED_ACCOUNT_ID=292960609118

# ---- Networking (Task #1 rebuild) ----
VPC_CIDR=10.0.0.0/16
SUBNET_A_CIDR=10.0.1.0/24
SUBNET_B_CIDR=10.0.2.0/24
AZ_A=us-east-1a
AZ_B=us-east-1b

# ---- Data tier ----
RDS_ID=floodguard-db
RDS_CLASS=db.t3.micro
RDS_ENGINE_VERSION=16.10
RDS_STORAGE_GB=20
RDS_DB_NAME=floodguard
RDS_USER=floodguard_admin

# ---- Compute tier (Elastic Beanstalk) ----
EB_APP_BACKEND=floodguard-team-9
EB_ENV_BACKEND=floodguard-backend
EB_APP_FRONTEND=floodguard-team-9-web
EB_ENV_FRONTEND=floodguard-team-9-frontend
EB_INSTANCE_TYPE_BACKEND=t3.small
EB_INSTANCE_TYPE_FRONTEND=t3.micro
EB_PLATFORM="64bit Amazon Linux 2023 v6.11.6 running Node.js 22"
# Pin to a single instance: @nestjs/schedule crons must not run on 2+ boxes.
EB_MIN_INSTANCES=1
EB_MAX_INSTANCES=1

# ---- Storage ----
S3_UPLOADS_BUCKET=floodguard-uploads-292960609118
S3_ARTIFACTS_BUCKET=floodguard-artifacts-292960609118

# ---- Task #2: serverless layer ----
DDB_WEATHER_TABLE=fg-weather-snapshots
SQS_FORECAST_QUEUE=fg-forecast-jobs
SQS_ALERT_QUEUE=fg-alert-dispatch
SNS_ALERTS_TOPIC=fg-flood-alerts
SNS_OPS_TOPIC=fg-ops-alarms
APIGW_NAME=fg-serverless-api
APIGW_STAGE=v1
SCHEDULER_NAME=fg-weather-ingest-schedule
SCHEDULE_EXPRESSION="rate(10 minutes)"
LAMBDA_RUNTIME=nodejs22.x
LAMBDA_ARCH=arm64
LAMBDA_TIMEOUT=60
LAMBDA_MEMORY=512

# ---- Secrets Manager ----
SECRET_NAME=floodguard/app

# ---- Monitoring ----
DASHBOARD_NAME=FloodGuard-Task2

# ---- EB environment topology ----
# Backend is LoadBalanced: the free tier covers 750 ALB hours/month, i.e. exactly
# one continuously-running ALB. Spending it on the API tier buys the ALB, health
# checks and an autoscaling group shown in the architecture diagram.
# Frontend is SingleInstance: CloudFront already caches and terminates TLS for it,
# so a second ALB would cost ~$18/mo for no benefit.
EB_ENV_TYPE_BACKEND=LoadBalanced
EB_ENV_TYPE_FRONTEND=SingleInstance
